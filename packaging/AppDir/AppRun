#!/bin/sh
set -eu
APPDIR="${APPDIR:-$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)}"
export PYTHONHOME="$APPDIR/usr"
export PYTHONPATH="$APPDIR/usr/src"
export LD_LIBRARY_PATH="$APPDIR/usr/lib/x86_64-linux-gnu${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export TCL_LIBRARY="$APPDIR/usr/share/tcltk/tcl8.6"
export TK_LIBRARY="$APPDIR/usr/lib/tcltk/x86_64-linux-gnu/tk8.6"
if [ -r /etc/pki/tls/certs/ca-bundle.crt ]; then
    export SSL_CERT_FILE=/etc/pki/tls/certs/ca-bundle.crt
elif [ -r /etc/ssl/certs/ca-certificates.crt ]; then
    export SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
fi
if [ "${1:-}" = "--background" ]; then
    shift
    exec "$APPDIR/usr/bin/python3" "$APPDIR/usr/src/monitor_tesouro/core.py" "$@"
fi
exec "$APPDIR/usr/bin/python3" -m monitor_tesouro "$@"
